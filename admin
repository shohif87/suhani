backend:
  name: github
  repo: shohif87/suhani
  branch: main

media_folder: "images"
public_folder: "/images"

collections:
  - name: "products"
    label: "পণ্য তালিকা (Products)"
    folder: "_products"
    create: true
    slug: "{{slug}}"
    fields:
      - {label: "পণ্যের আইডি (ID)", name: "id", widget: "number"}
      - {label: "পণ্যের নাম (Title)", name: "name", widget: "string"}
      - {label: "দাম (Price)", name: "price", widget: "number"}
      - {label: "পণ্যের ছবি (Image URL)", name: "image", widget: "image"}
      - {label: "পণ্যের বিবরণ (Description)", name: "desc", widget: "text"}
